# Hostinger env for alkinda.com — set in hPanel Node.js → Environment variables
# Do not commit real secrets.

# —— Portal (alkinda.com) ——
NEXT_PUBLIC_PORTAL_NAME=Alkinda
NEXT_PUBLIC_PORTAL_DOMAIN=alkinda.com
NEXT_PUBLIC_LABEL=alkinda

# —— Hostinger MySQL (Node.js: use Remote MySQL hostname, not localhost) ——
# Suggested DB/user names (Hostinger may add a uXXXX_ prefix):
#   DB_NAME=…_lineage
#   DB_USER=…_lineage
DB_HOST=srvXXXX.hstgr.io
DB_PORT=3306
DB_USER=uXXXX_lineage
DB_PASSWORD=change-me
DB_NAME=uXXXX_lineage
