# Copy to Hostinger Node.js → Environment variables (do not commit real secrets)

# —— Portal ——
NEXT_PUBLIC_PORTAL_NAME=App Hub
NEXT_PUBLIC_PORTAL_DOMAIN=your-domain.com
NEXT_PUBLIC_LABEL=hostinger-portal

# —— Hostinger MySQL (Node.js must use MySQL hostname, not localhost) ——
# From hPanel → Databases → Remote MySQL → hostname e.g. srv1517.hstgr.io
DB_HOST=srvXXXX.hstgr.io
DB_PORT=3306
DB_USER=uXXXX_lineage
DB_PASSWORD=change-me
DB_NAME=uXXXX_lineage

# Optional single URL form (if you prefer):
# DATABASE_URL=mysql://uXXXX_lineage:change-me@srvXXXX.hstgr.io:3306/uXXXX_lineage
